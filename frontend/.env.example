# Sat AI — Firebase web config (public values only, no secrets).
# Copy to .env and paste your project's config from:
#   Firebase console → satqueryai-7ebac → Project settings → General → Your apps → Web app → Config
#
# IMPORTANT: no spaces around `=` — a leading space silently breaks auth.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
