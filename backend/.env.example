# Sat AI backend — copy to .env and adjust (values are read as plain process.env;
# on Windows PowerShell you can also set them inline, e.g. $env:SERVICE_ACCOUNT_PATH="...")
PORT=4000

# Path to the Firebase service-account JSON:
# Firebase console → satqueryai-7ebac → Project settings → Service accounts →
# Generate new private key → save as backend/credentials/service-account.json (gitignored).
SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# Dev-only escape hatch: 1 = skip ID-token verification (loud warnings, never in production).
# Without a service account, protected routes return 503 unless this is set.
AUTH_DEV_MODE=0
